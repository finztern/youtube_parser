# Local collector endpoint (POST {"items":[...]}). Never upload.exorde.network directly.
# Collector on the Docker host: http://host.docker.internal:8080/items
STORE_ENDPOINT=http://host.docker.internal:8080/items
URL_CHECK_ENDPOINT=https://url-check.exorde.network/v1/check
# "pool" = url-check goes through a working VPN node; empty = direct; or socks5h://host:port
URL_CHECK_PROXY=pool
# Own subscription URL(s) (vless + hysteria2), whitespace/comma separated. SECRET: .env only, never git.
VPN_SOURCES_EXTRA=
# 1 = use only VPN_SOURCES_EXTRA, skip the free public lists
VPN_ONLY=1
SINGBOX_BIN=/usr/local/bin/sing-box
LOG_LEVEL=INFO
# web dashboard (0 = off); 0.0.0.0 = open on the LAN, 127.0.0.1 = local only; no auth
DASH_HOST=0.0.0.0
DASH_PORT=8090
# Use the nodes of the local service instead of free lists: GET returns {"alive_ports": [...]} (one SOCKS port per node).
# The list is re-read every vpn.local_refresh_seconds. From Docker the host is host.docker.internal; with network_mode: host use 127.0.0.1.
NODES_ENDPOINT=
NODES_HOST=host.docker.internal
NODES_SCHEME=socks5h
# CPU cap of the container in cores (docker-compose cpus); lower = less load, fewer polls
CPU_LIMIT=3
