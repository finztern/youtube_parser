     }
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "hot \u00b7 videos \u00b7 seen",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
