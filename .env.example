# Local collector endpoint (POST {"items":[...]}). Never upload.exorde.network directly.
# Collector on the Docker host: http://host.docker.internal:8080/items
STORE_ENDPOINT=http://host.docker.internal:8080/items
URL_CHECK_ENDPOINT=https://url-check.exorde.network/v1/check
# "pool" = url-check goes through a working VPN node; empty = direct; or socks5h://host:port
URL_CHECK_PROXY=pool
# Own vless subscription URL(s), whitespace/comma separated. SECRET: .env only, never git.
VPN_SOURCES_EXTRA=
# 1 = use only VPN_SOURCES_EXTRA, skip the free public lists
VPN_ONLY=1
XRAY_BIN=/usr/local/bin/xray
LOG_LEVEL=INFO
# web dashboard (0 = off); 0.0.0.0 = open on the LAN, 127.0.0.1 = local only; no auth
DASH_HOST=0.0.0.0
DASH_PORT=8090
